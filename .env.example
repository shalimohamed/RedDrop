# Copy this file to .env.local and fill in your own values.
# .env.local is already in .gitignore — never commit real keys.

# Firebase project config — Project settings → General → Your apps → SDK setup
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Firebase Cloud Messaging — Project settings → Cloud Messaging → Web Push certificates
VITE_FIREBASE_VAPID_KEY=

# Google Maps JavaScript API key (FR-011) — console.cloud.google.com → APIs & Services
VITE_GOOGLE_MAPS_API_KEY=

# AI Chatbot backend endpoint (FR-014) — point this at your own Cloud
# Function / server that wraps an LLM API. Never put a raw LLM API key here;
# this is a public, browser-exposed value.
VITE_CHATBOT_API_URL=
