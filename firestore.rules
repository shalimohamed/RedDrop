rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function roleOf(userId) {
      return get(/databases/$(database)/documents/users/$(userId)).data.role;
    }

    function isFacility() {
      return isSignedIn() && roleOf(request.auth.uid) == 'facility';
    }

    function isDonor() {
      return isSignedIn() && roleOf(request.auth.uid) == 'donor';
    }

    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if isOwner(userId);
      allow update: if isOwner(userId) && request.resource.data.role == resource.data.role;
      allow delete: if false;
    }

    match /donors/{donorId} {
      allow read: if true;
      allow create: if isOwner(donorId);
      allow update: if isOwner(donorId)
        || (isFacility() && request.resource.data.diff(resource.data)
              .affectedKeys().hasOnly(['totalDonations', 'lastDonationDate']));
      allow delete: if false;
    }

    match /facilities/{facilityId} {
      allow read: if true;
      allow create: if isOwner(facilityId);
      allow update: if isOwner(facilityId);
      allow delete: if false;
    }

    match /appeals/{appealId} {
      allow read: if true;
      allow create: if isFacility() && request.resource.data.facilityId == request.auth.uid;
      allow update: if isFacility() && resource.data.facilityId == request.auth.uid;
      allow delete: if false;
    }

    match /responses/{responseId} {
      allow create: if true;
      allow read: if isSignedIn() &&
        (isDonor() && resource.data.donorId == request.auth.uid ||
         isFacility() && resource.data.facilityId == request.auth.uid);
      allow update: if isFacility()
        && resource.data.facilityId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'donatedAt'])
        && resource.data.status == 'Confirmed'
        && request.resource.data.status == 'Donated';
      allow delete: if false;
    }

    match /stats/{statId} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly(['totalResponses']) &&
        request.resource.data.totalResponses == 1;
      allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly(['totalResponses']) &&
        request.resource.data.totalResponses == resource.data.totalResponses + 1;
      allow delete: if false;
    }

    match /events/{eventId} {
      allow read: if true;
      allow create: if isFacility() && request.resource.data.facilityId == request.auth.uid;
      allow update, delete: if isFacility() && resource.data.facilityId == request.auth.uid;
    }

    match /notifications/{notificationId} {
      allow read: if isSignedIn() && resource.data.recipientId == request.auth.uid;
      allow update: if isSignedIn() && resource.data.recipientId == request.auth.uid;
      allow create, delete: if false;
    }
  }
}
